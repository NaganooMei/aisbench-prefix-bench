{
  "services": [
    {
      "name": "svc-a",
      "base_url": "http://127.0.0.1:8000",
      "served_model": "model-a",
      "model_path": "/models/model-a",
      "dp": 1
    },
    {
      "name": "svc-b",
      "base_url": "http://127.0.0.1:8001",
      "served_model": "model-b",
      "model_path": "/models/model-b",
      "dp": 1
    }
  ],
  "cases": [
    {
      "input_len": 8192,
      "output_len": 1,
      "hit_rate": 0.9,
      "concurrency": 8,
      "num_requests": 16
    }
  ],
  "modes": [
    "hbm",
    "cache",
    "posix-reset"
  ],
  "block_tokens": 128,
  "warmup": {
    "enabled": true,
    "input_len": 8192,
    "output_len": 1,
    "hit_rate": 0.9,
    "concurrency": 4,
    "num_requests": 4,
    "rounds": 1
  },
  "corpus_path": "/data/datasets/GSM8K.jsonl",
  "work_dir": "work",
  "results_dir": "results",
  "seed_settle_seconds": 1,
  "reset": {
    "timeout_seconds": 60,
    "retry_interval_seconds": 1
  },
  "metrics": {
    "enabled": false,
    "settle_seconds": 1,
    "timeout_seconds": 10
  },
  "aisbench": {
    "command": "ais_bench",
    "summarizer": "default_perf",
    "configs_dir": "",
    "extra_args": [],
    "timeout_seconds": 3600
  }
}
